index 0000000..bd20d14
--- /dev/null
+++ b/app/cdcl-trace-snapshot/Main.hs
@@ -0,0 +1,219 @@
+{-# LANGUAGE GHC2021 #-}
+{-# LANGUAGE OverloadedLists #-}
+
+module Main (main) where
+
+import Crypto.Hash.SHA256 qualified as SHA256
+import Data.ByteString qualified as BS
+import Data.ByteString.Char8 qualified as BS8
+import Data.HashSet qualified as HS
+import Data.List (intercalate, sort)
+import Logic.Propositional.Classical.SAT.CDCL
+import Logic.Propositional.Classical.SAT.CDCL.Types (
+  SolverTraceEvent,
+  solverTraceSchemaVersion,
+ )
+import Logic.Propositional.Classical.SAT.Types (Model (..), SatResult (..))
+import Numeric (showHex)
+
+main :: IO ()
+main = do
+  putStrLn $ "solver-trace-schema=" <> show solverTraceSchemaVersion
+  mapM_ emitSnapshot snapshotCases
+
+data TraceDetail = ExactTrace | DigestTrace
+
+data SnapshotCase = SnapshotCase
+  { snapshotName :: !String
+  , snapshotOptions :: !CDCLOptions
+  , snapshotCNF :: !(CNF VarId)
+  , snapshotTraceDetail :: !TraceDetail
+  }
+
+emitSnapshot :: SnapshotCase -> IO ()
+emitSnapshot
+  SnapshotCase
+    { snapshotName
+    , snapshotOptions
+    , snapshotCNF
+    , snapshotTraceDetail
+    } = do
+    let (result, stats) = solveVarIdWithStats snapshotOptions snapshotCNF
+    putStrLn $ "case=" <> snapshotName
+    putStrLn $ "result=" <> normalizeResult result
+    putStrLn $ "stats=" <> serializeScalarStats stats
+    putStrLn $ "trace-count=" <> show (length $ solverTrace stats)
+    case snapshotTraceDetail of
+      ExactTrace ->
+        putStrLn $ "trace=" <> serializeTrace (solverTrace stats)
+      DigestTrace ->
+        putStrLn $
+          "trace-sha256="
+            <> sha256Hex (serializeTrace $ solverTrace stats)
+
+normalizeResult :: SatResult (Model VarId) -> String
+normalizeResult Unsat = "Unsat"
+normalizeResult (Satisfiable Model {positive, negative}) =
+  "Satisfiable "
+    <> show
+      ( sort $ HS.toList positive
+      , sort $ HS.toList negative
+      )
+
+serializeScalarStats :: SolverStats -> String
+serializeScalarStats stats =
+  intercalate
+    ","
+    [ field "seedScanCount" seedScanCount
+    , field "postDrainScanCount" postDrainScanCount
+    , field "assignmentCount" assignmentCount
+    , field "trailAppendCount" trailAppendCount
+    , field "duplicateEnqueueCount" duplicateEnqueueCount
+    , field "propagationEventCount" propagationEventCount
+    , field "watchVisitCount" watchVisitCount
+    , field "watchMoveCount" watchMoveCount
+    , field "literalInspectionCount" literalInspectionCount
+    , field "decisionCount" decisionCount
+    , field "conflictCount" conflictCount
+    , field "backtrackCallCount" backtrackCallCount
+    , field "backtrackBoundaryReadCount" backtrackBoundaryReadCount
+    , field "backtrackTrailReadCount" backtrackTrailReadCount
+    , field "backtrackClearedCount" backtrackClearedCount
+    , field "backtrackValuationReadCount" backtrackValuationReadCount
+    , field "backtrackValuationWriteCount" backtrackValuationWriteCount
+    , field "backtrackQueueRestoreCount" backtrackQueueRestoreCount
+    , field "backtrackBoundaryProbeCount" backtrackBoundaryProbeCount
+    , field "backtrackNoOpCount" backtrackNoOpCount
+    , field "backtrackMaxSuffix" backtrackMaxSuffix
+    , field "ordinaryBacktrackCount" ordinaryBacktrackCount
+    , field "restartBacktrackCount" restartBacktrackCount
+    , field "observedRestartCount" observedRestartCount
+    ]
+  where
+    field name accessor = name <> "=" <> show (accessor stats)
+
+serializeTrace :: [SolverTraceEvent] -> String
+serializeTrace = show
+
+sha256Hex :: String -> String
+sha256Hex =
+  foldMap byteHex
+    . BS.unpack
+    . SHA256.hash
+    . BS8.pack
+  where
+    byteHex byte =
+      case showHex byte "" of
+        [digit] -> ['0', digit]
+        digits -> digits
+
+snapshotCases :: [SnapshotCase]
+snapshotCases =
+  [ SnapshotCase "root-units" defaultOptions rootUnitsCNF ExactTrace
+  , SnapshotCase
+      "mixed-polarity-watch"
+      defaultOptions
+      mixedPolarityWatchCNF
+      DigestTrace
+  , SnapshotCase
+      "long-watch-chain"
+      defaultOptions
+      longWatchMoveCNF
+      DigestTrace
+  , SnapshotCase
+      "watch-suffix-restore"
+      defaultOptions
+      watchSuffixRestoreCNF
+      ExactTrace
+  , SnapshotCase
+      "restart-satisfiable"
+      defaultOptions {restartStrategy = ExponentialRestart 1 2}
+      restartWitnessCNF
+      ExactTrace
+  , SnapshotCase
+      "restart-unsatisfiable"
+      defaultOptions {restartStrategy = ExponentialRestart 1 2}
+      allBinaryTwoCNF
+      ExactTrace
+  , SnapshotCase
+      "pure-literal-bypass"
+      defaultOptions
+      sparsePureLiteralCNF
+      ExactTrace
+  , SnapshotCase
+      "pure-literal-fallback"
+      defaultOptions
+      sparsePureLiteralFallbackCNF
+      ExactTrace
+  ]
+
+rootUnitsCNF :: CNF VarId
+rootUnitsCNF =
+  CNF
+    [ [Positive 0]
+    , [Negative 0, Positive 1]
+    , [Negative 1, Positive 2]
+    ]
+
+restartWitnessCNF :: CNF VarId
+restartWitnessCNF =
+  CNF
+    [ [Positive 0, Positive 1, Positive 2]
+    , [Positive 0, Positive 1, Negative 2]
+    , [Positive 3]
+    , [Negative 3, Negative 1, Positive 4]
+    , [Negative 3, Negative 1, Negative 4]
+    ]
+
+allBinaryTwoCNF :: CNF VarId
+allBinaryTwoCNF =
+  CNF
+    [ [Positive 0, Positive 1]
+    , [Positive 0, Negative 1]
+    , [Negative 0, Positive 1]
+    , [Negative 0, Negative 1]
+    ]
+
+mixedPolarityWatchCNF :: CNF VarId
+mixedPolarityWatchCNF =
+  CNF $
+    [[Positive 0]]
+      <> [[Positive 0, Positive i] | i <- [1 .. 64]]
+      <> [[Negative 0, Positive i] | i <- [65 .. 128]]
+
+longWatchMoveCNF :: CNF VarId
+longWatchMoveCNF =
+  CNF $
+    [CNFClause [Negative 0]]
+      <> [CNFClause [Positive i, Negative (i + 1)] | i <- [0 .. 126]]
+      <> [CNFClause [Positive i | i <- [0 .. 127]]]
+
+watchSuffixRestoreCNF :: CNF VarId
+watchSuffixRestoreCNF =
+  CNF
+    [ [Positive 1, Positive 2]
+    , [Positive 1, Positive 3]
+    , [Positive 1, Positive 4]
+    , [Positive 0, Negative 1]
+    , [Positive 0, Negative 2]
+    , [Positive 0, Positive 5]
+    , [Positive 0, Positive 6]
+    , [Positive 0, Positive 7]
+    , [Positive 0, Positive 8]
+    , [Positive 0, Positive 9]
+    ]
+
+sparsePureLiteralCNF :: CNF VarId
+sparsePureLiteralCNF =
+  CNF
+    [ CNFClause $ Negative 0 : [Negative i | i <- [1 .. 8]]
+    , CNFClause [Positive i | i <- [1 .. 8]]
+    ]
+
+sparsePureLiteralFallbackCNF :: CNF VarId
+sparsePureLiteralFallbackCNF =
+  CNF
+    [ CNFClause [Positive i | i <- [1 .. 30]]
+    , CNFClause [Positive 0]
+    , CNFClause [Negative 0]
+    ]
